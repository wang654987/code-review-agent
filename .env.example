# Code Review Agent v0.2.0 — Environment Configuration
# Copy this to .env and fill in your values

# === Required ===
GITHUB_TOKEN=ghp_xx...n
WEBHOOK_SECRET=your-w...n

# === LLM — Primary Model ===
# litellm 格式: provider/model
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=sk-xxx...n
# === LLM — Secondary Model (Phase 2: dual-model cross-validation) ===
# 留空则只用单模型。推荐配置不同的模型以增强交叉验证效果,
# 例如主模型用 deepseek, 副模型用 openai/gpt-4o-mini
LLM_MODEL_SECONDARY=
LLM_API_KEY_SECONDARY=

# === Pipeline Controls ===
# 设为 false 可以关闭某个阶段
ENABLE_SEMGREP=true
ENABLE_CONTEXT_BUILDER=true
ENABLE_DUAL_MODEL=false   # 需要先配置 LLM_MODEL_SECONDARY

# === Optional ===
REVIEW_LANGUAGE=zh
PORT=8000
LOG_LEVEL=INFO
